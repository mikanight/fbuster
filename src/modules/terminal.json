{
  "id": "terminal",
  "title": "Терминал",
  "icon": "utilities-terminal-symbolic",
  "groups": [
    {
      "id": "ghostty",
      "title": "Ghostty",
      "description": "Современный GPU-ускоренный терминал из COPR (scottames/ghostty)",
      "rows": [
        {
          "id": "ghostty_install",
          "type": "command_row",
          "title": "Установить Ghostty",
          "subtitle": "dnf copr enable scottames/ghostty && dnf install ghostty",
          "icon": "utilities-terminal-symbolic",
          "button_label": "Установить",
          "button_done_label": "Установлен",
          "check": { "type": "which", "value": "ghostty" },
          "action": { "type": "privileged", "cmd": ["bash", "-c", "dnf copr enable scottames/ghostty -y && dnf install -y --nogpgcheck ghostty"] }
        },
        {
          "id": "ghostty_default",
          "type": "command_row",
          "title": "Ghostty по умолчанию",
          "subtitle": "~/.config/xdg-terminals.list → com.mitchellh.ghostty.desktop",
          "icon": "starred-symbolic",
          "button_label": "Применить",
          "button_done_label": "Применено",
          "button_style": "flat",
          "check": { "type": "builtin", "fn": "check_ghostty_default" },
          "action": { "type": "builtin", "fn": "set_ghostty_default" }
        }
      ]
    },
    {
      "id": "shortcuts",
      "title": "Горячие клавиши",
      "description": "Шорткаты для открытия терминала",
      "rows": [
        {
          "id": "shortcut_1",
          "type": "command_row",
          "title": "Terminal 1",
          "subtitle": "Ctrl + Alt + T",
          "icon": "input-keyboard-symbolic",
          "button_label": "Назначить",
          "button_done_label": "Назначен",
          "check": { "type": "builtin", "fn": "check_shortcut_1" },
          "action": { "type": "builtin", "fn": "set_shortcut_1" }
        },
        {
          "id": "shortcut_2",
          "type": "command_row",
          "title": "Terminal 2",
          "subtitle": "Super + Enter",
          "icon": "input-keyboard-symbolic",
          "button_label": "Назначить",
          "button_done_label": "Назначен",
          "check": { "type": "builtin", "fn": "check_shortcut_2" },
          "action": { "type": "builtin", "fn": "set_shortcut_2" }
        }
      ]
    },
    {
      "id": "zsh",
      "title": "ZSH",
      "description": "Устанавливает zsh + git + zplug, делает ZSH shell по умолчанию",
      "rows": [
        {
          "id": "zsh_install",
          "type": "command_row",
          "title": "Установить git и zsh",
          "subtitle": "dnf install -y git zsh",
          "icon": "utilities-terminal-symbolic",
          "button_label": "Установить",
          "button_done_label": "Установлен",
          "check": { "type": "which", "value": "zsh" },
          "action": { "type": "privileged", "cmd": ["dnf", "install", "-y", "git", "zsh"] }
        },
        {
          "id": "zplug_install",
          "type": "command_row",
          "title": "Установить zplug",
          "subtitle": "git clone https://github.com/zplug/zplug ~/.zplug",
          "icon": "utilities-terminal-symbolic",
          "button_label": "Установить",
          "button_done_label": "Установлен",
          "check": { "type": "path", "value": "~/.zplug" },
          "action": { "type": "builtin", "fn": "install_zplug" }
        },
        {
          "id": "zsh_default",
          "type": "command_row",
          "title": "ZSH по умолчанию",
          "subtitle": "chsh -s /bin/zsh",
          "icon": "system-run-symbolic",
          "button_label": "Применить",
          "button_done_label": "Применено",
          "check": { "type": "builtin", "fn": "check_zsh_default" },
          "action": { "type": "builtin", "fn": "set_zsh_default" }
        }
      ]
    },
    {
      "id": "fastfetch",
      "title": "Fastfetch + шрифты",
      "description": "Системная информация с иконками Nerd Fonts",
      "rows": [
        {
          "id": "fastfetch_install",
          "type": "command_row",
          "title": "Установить Fastfetch",
          "subtitle": "dnf install fastfetch",
          "icon": "dialog-information-symbolic",
          "button_label": "Установить",
          "button_done_label": "Установлен",
          "check": { "type": "which", "value": "fastfetch" },
          "action": { "type": "privileged", "cmd": ["dnf", "install", "-y", "fastfetch"] }
        },
        {
          "id": "firacode_install",
          "type": "command_row",
          "title": "Шрифт FiraCode Nerd Font",
          "subtitle": "dnf install fira-code-fonts",
          "icon": "font-x-generic-symbolic",
          "button_label": "Установить",
          "button_done_label": "Установлен",
          "check": { "type": "rpm", "value": "fira-code-fonts" },
          "action": { "type": "privileged", "cmd": ["dnf", "install", "-y", "fira-code-fonts"] }
        },
        {
          "id": "font_apply",
          "type": "command_row",
          "title": "Применить шрифт в Ghostty",
          "subtitle": "FiraCode Nerd Font Regular 14",
          "icon": "font-x-generic-symbolic",
          "button_label": "Применить",
          "button_done_label": "Применён",
          "button_style": "flat",
          "check": { "type": "builtin", "fn": "check_ghostty_font" },
          "action": { "type": "builtin", "fn": "set_ghostty_font" }
        },
        {
          "id": "ffcfg_install",
          "type": "command_row",
          "title": "Конфиг plafonfetch.jsonc",
          "subtitle": "Сохраняет в ~/.config/fastfetch/plafonfetch.jsonc",
          "icon": "document-save-symbolic",
          "button_label": "Установить",
          "button_done_label": "Установлен",
          "check": { "type": "path", "value": "~/.config/fastfetch/plafonfetch.jsonc" },
          "action": { "type": "builtin", "fn": "install_fastfetch_config" }
        }
      ]
    },
    {
      "id": "aliases",
      "title": "Алиасы PLAFON",
      "description": "Добавляет набор алиасов в ~/.zshrc",
      "rows": [
        {
          "id": "aliases_add",
          "type": "command_row",
          "title": "Добавить алиасы в .zshrc",
          "subtitle": "Алиасы для dnf, flatpak, timeshift, DaVinci и др.",
          "icon": "text-editor-symbolic",
          "button_label": "Добавить",
          "button_done_label": "Добавлены",
          "check": { "type": "builtin", "fn": "check_zsh_aliases" },
          "action": { "type": "builtin", "fn": "add_zsh_aliases" }
        }
      ]
    }
  ]
}
